rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.:@]+$');
    }

    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100
        && data.email is string && data.email.size() <= 150
        && (!('country' in data) || (data.country is string && data.country.size() <= 100))
        && (!('countryCode' in data) || (data.countryCode is string && data.countryCode.size() <= 10))
        && (!('preferredLocation' in data) || (data.preferredLocation is string && data.preferredLocation.size() <= 150))
        && (!('targetRole' in data) || (data.targetRole is string && data.targetRole.size() <= 120))
        && (!('emailVerified' in data) || data.emailVerified is bool)
        && (!('isGoogleAccount' in data) || data.isGoogleAccount is bool);
    }

    function isValidResume(data) {
      return data.id is string && data.id.size() <= 128
        && data.fullName is string && data.fullName.size() > 0 && data.fullName.size() <= 100
        && data.title is string && data.title.size() > 0 && data.title.size() <= 120
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('atsScore' in data) || (data.atsScore is number && data.atsScore >= 0 && data.atsScore <= 100));
    }

    function isValidSavedJob(data) {
      return data.id is string && data.id.size() <= 128
        && data.jobTitle is string && data.jobTitle.size() > 0 && data.jobTitle.size() <= 150
        && data.company is string && data.company.size() > 0 && data.company.size() <= 150
        && (!('location' in data) || (data.location is string && data.location.size() <= 150))
        && (!('salary' in data) || (data.salary is string && data.salary.size() <= 100))
        && (!('status' in data) || (data.status is string && data.status.size() <= 50))
        && (!('applyUrl' in data) || (data.applyUrl is string && data.applyUrl.size() <= 1000));
    }

    function isValidDatabaseEntry(data) {
      return data.id is string && data.id.size() <= 128
        && data.collectionName is string && data.collectionName.size() > 0 && data.collectionName.size() <= 64
        && data.action is string && data.action.size() > 0 && data.action.size() <= 64
        && data.summary is string && data.summary.size() > 0 && data.summary.size() <= 300
        && (!('details' in data) || (data.details is string && data.details.size() <= 2000))
        && (!('timestamp' in data) || (data.timestamp is string && data.timestamp.size() <= 64));
    }

    // User accounts collection
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create, update: if isValidId(userId) && isValidUserProfile(request.resource.data);
      allow delete: if isValidId(userId);
    }

    // Resumes collection
    match /resumes/{resumeId} {
      allow get: if isValidId(resumeId);
      allow list: if true;
      allow create, update: if isValidId(resumeId) && isValidResume(request.resource.data);
      allow delete: if isValidId(resumeId);
    }

    // Saved jobs collection
    match /savedJobs/{savedJobId} {
      allow get: if isValidId(savedJobId);
      allow list: if true;
      allow create, update: if isValidId(savedJobId) && isValidSavedJob(request.resource.data);
      allow delete: if isValidId(savedJobId);
    }

    // Health check collection
    match /test/{testId} {
      allow get: if isValidId(testId);
    }

    // Real-time Database Activity stream
    match /databaseEntries/{entryId} {
      allow get: if isValidId(entryId);
      allow list: if true;
      allow create, update: if isValidId(entryId) && isValidDatabaseEntry(request.resource.data);
      allow delete: if isValidId(entryId);
    }
  }
}
